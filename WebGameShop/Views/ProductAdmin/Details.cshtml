@model WebGameShop.Models.Product

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<style>
    .background-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #171a21;
        z-index: -1;
    }

</style>

<!-- Video làm nền toàn trang -->
<div class="background-container">
    @* 
    <video autoplay muted loop playsinline style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1; filter: brightness(0.5); opacity: 1;">
        <source src="/assets/images/backmythwukong7.mp4" type="video/mp4" />
    </video>
    *@
</div>

<div style="display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 100vh; position: relative; z-index: 1;">
    <h1 style="text-align: center; font-family: 'Orbitron', sans-serif; color: #00ffcc; text-shadow: 0 0 10px aqua; font-size: 2.5em; margin-bottom: 20px; background-color: #171a21;  padding: 10px;  border-radius: 10px;">
        <span style="display: inline-block; padding-top: 20px;">Quản lý Sản phẩm</span>
    </h1>

    <p style="text-align: center; margin-bottom: 20px; position: relative; z-index: 1;">
        <a asp-action="Create" class="btn btn-primary" style="background-color: #171a21 !important; backdrop-filter: blur(10px); color: #fff; border: 2px solid aqua !important; padding: 10px 20px; font-family: 'Orbitron', sans-serif; font-size: 1.1em; border-radius: 20px; text-transform: uppercase; box-shadow: 0 0 15px #00ffcc; transition: transform 0.3s ease; position: relative; z-index: 1; text-decoration: none;">Thêm sản phẩm mới</a>
    </p>

    <table class="table table-striped table-hover" style="width: 100%; max-width: 1400px; font-family: 'Orbitron', sans-serif; color: #fff; background: rgba(15, 12, 41, 0.3); border: 2px solid #00ffcc; border-radius: 10px; overflow: hidden; box-shadow: 0 0 20px #00ffcc; position: relative; z-index: 1;">
        <thead style="background: linear-gradient(90deg, #302b63, #24243e); padding: 10px;">
            <tr style="border-bottom: 2px solid #00ffcc;">
                <th style="padding: 10px; text-align: center; color: #00ffcc; text-shadow: 0 0 5px #00ffcc;">
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th style="padding: 10px; text-align: center; color: #00ffcc; text-shadow: 0 0 5px #00ffcc;">
                    @Html.DisplayNameFor(model => model.Detail)
                </th>
                <th style="padding: 10px; text-align: center; color: #00ffcc; text-shadow: 0 0 5px #00ffcc;">
                    @Html.DisplayNameFor(model => model.ImageUrl)
                </th>
                <th style="padding: 10px; text-align: center; color: #00ffcc; text-shadow: 0 0 5px #00ffcc;">
                    @Html.DisplayNameFor(model => model.Price)
                </th>
                <th style="padding: 10px; text-align: center; color: #00ffcc; text-shadow: 0 0 5px #00ffcc;">
                    @Html.DisplayNameFor(model => model.IsTrendingProduct)
                </th>
                <th style="padding: 10px; text-align: center; color: #00ffcc; text-shadow: 0 0 5px #00ffcc;">
                    @Html.DisplayNameFor(model => model.Category)
                </th>
                <th style="padding: 10px; text-align: center; color: #00ffcc; text-shadow: 0 0 5px #00ffcc;"></th>
            </tr>
        </thead>
        <tbody>
            <tr style="border-bottom: 1px solid #00ffcc; transition: background-color 0.3s ease;">
                <td style="padding: 10px; text-align: center; color: #fff; background: rgba(0, 0, 0, 0.3);">
                    @Html.DisplayFor(model => model.Name)
                </td>
                <td style="padding: 10px; text-align: center; color: #fff; background: rgba(0, 0, 0, 0.3);">
                    @(Model.Detail != null && Model.Detail.Length > 70 ? Model.Detail.Substring(0, 70) + "..." : Model.Detail)
                </td>
                <td style="padding: 10px; text-align: center; background: rgba(0, 0, 0, 0.3);">
                    <img src="@Model.ImageUrl" alt="Product Image" style="max-width: 80px; height: auto; border: 2px solid #00ffcc; border-radius: 5px;" class="img-thumbnail" />
                </td>
                <td style="padding: 10px; text-align: center; color: #fff; background: rgba(0, 0, 0, 0.3);">
                    @Model.Price.ToString("N0") VNĐ
                </td>
                <td style="padding: 10px; text-align: center; background: rgba(0, 0, 0, 0.3);">
                    <input type="checkbox" disabled checked="@Model.IsTrendingProduct" style="margin: 0 auto; display: block;" />
                </td>
                <td style="padding: 10px; text-align: center; color: #fff; background: rgba(0, 0, 0, 0.3);">
                    @Html.DisplayFor(model => model.Category)
                </td>
                <td style="padding: 10px; text-align: center; background: rgba(0, 0, 0, 0.3);">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning" style="background: #ffeb3b; color: #000; border: none; padding: 5px 10px; border-radius: 5px; margin-right: 5px; transition: transform 0.3s ease;">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-info" style="background: #2196f3; color: #fff; border: none; padding: 5px 10px; border-radius: 5px; margin-right: 5px; transition: transform 0.3s ease;">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-danger" style="background: red !important; color: #fff !important; border: none;  border-radius: 5px; transition: transform 0.3s ease; width: 70px;">Xóa</a>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<style>
    /* Đảm bảo font Orbitron được tải */

    tr:hover {
        background: rgba(0, 255, 204, 0.2) !important;
        transform: scale(1.01);
    }

    a.btn:hover {
        transform: scale(1.1);
    }

    #background-video {
        /* Thêm fallback nếu video không tải */
        background: #171a21; /* Màu nền mặc định nếu video lỗi */
    }
</style>
